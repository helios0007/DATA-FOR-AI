# New RAG settings.
# The current retriever does not require an LLM key.

# Optional future answer-generation provider.
# Use this only if you extend new_rag to generate final answers with Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional local judge/answer model if you add local generation.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434/api/generate
