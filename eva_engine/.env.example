# Portable RAG evaluation engine settings.
# Copy this file to .env and fill in only the provider you want to use for --judge.

# Supported: openai, gemini, anthropic, claude, ollama.
JUDGE_PROVIDER=anthropic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434/api/generate
