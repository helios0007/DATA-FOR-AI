# Portable RAG evaluation engine settings.
# Copy this file to .env and fill in only the provider you want to use for --judge.

JUDGE_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434/api/generate
